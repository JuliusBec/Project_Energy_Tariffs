# Development Dockerfile for DYNERGY Frontend
# This runs Vite dev server instead of building static files

FROM node:18-alpine

WORKDIR /app

# Install dependencies
COPY src/frontend/package*.json ./
RUN npm install

# Copy source code
COPY src/frontend/ ./

# Expose Vite dev server port
EXPOSE 3000

# Run Vite dev server with host 0.0.0.0 to allow external access
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
